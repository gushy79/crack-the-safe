# Crack the Safe -- build configuration.
#
# NEVER edit `sdkconfig` directly: it is generated and gitignored, so an edit
# there is invisible to review. Everything goes here, and this file only SEEDS
# a new `sdkconfig` -- ESP-IDF does not re-apply it to an existing one. After
# changing anything below:
#
#     rm sdkconfig && idf.py build
#
# then confirm the key landed with `grep CONFIG_THE_KEY sdkconfig`.

CONFIG_IDF_TARGET="esp32s3"

# ---------------------------------------------------------------------------
# Memory: ESP32-S3R8 -- 8 MB OCTAL PSRAM in the package -- and 16 MB external
# flash. QIO (the flash reports it; measured steadier door frames than DIO).
# Auto-detect must be off or the build keeps the DIO header.
# ---------------------------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# CONFIG_ESPTOOLPY_FLASH_MODE_AUTO_DETECT is not set
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# -O2, not the default -Og: LVGL's software blending is the door animation's
# cost. Measured per door frame: 165 ms at -Og, 133 ms at -O2.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The S3's own USB-Serial/JTAG is what the USB-C port reaches in the S3
# orientation; the CH340 on the other orientation belongs to the ESP32.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 1 kHz tick: LVGL animation and the 3 ms knob poll both want it.
CONFIG_FREERTOS_HZ=1000

# ---------------------------------------------------------------------------
# LVGL 9. Every MONTSERRAT_<n> the .eez-project references must be enabled
# here. The game's type is custom Roboto fonts embedded in the project and
# exported as ui_font_*; Montserrat is only the placeholder screen's.
# ---------------------------------------------------------------------------
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y

# lv_malloc() from the ESP heap rather than LVGL's fixed 64 KB pool. EEZ's
# export builds every screen at boot, and LVGL's out-of-memory handler is an
# infinite loop that presents as a watchdog reset.
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y

# Compressed images (tools/compress_images.py): the LZ4 decoder, whole-image
# decode to RAM (without it they silently fail to draw), and an image cache so
# a frame is decoded once, not once per 24-line strip. The cache lives in PSRAM
# (lv_malloc is the ESP heap) and holds the door frame, prize and glow on screen.
CONFIG_LV_USE_LZ4=y
CONFIG_LV_USE_LZ4_INTERNAL=y
CONFIG_LV_BIN_DECODER_RAM_LOAD=y
CONFIG_LV_CACHE_DEF_SIZE=2097152

# Wi-Fi (wifi_link.c): the radio's buffers go to PSRAM rather than the small
# internal RAM the display's DMA buffers need.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# The Wi-Fi setup page's QR code (joins the board's hotspot).
CONFIG_LV_USE_QRCODE=y
